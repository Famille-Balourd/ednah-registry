# .env.example — VERSIONNÉ (aucune vraie valeur, placeholders uniquement)

# Environnement Node
NODE_ENV=production

# Port d'écoute (Coolify injecte souvent PORT). Le serveur écoute sur 0.0.0.0.
PORT=3000

# Connexion Postgres — injectée par Coolify (réseau Docker interne, jamais d'IP publique).
DATABASE_URL=postgres://user:password@db:5432/studio_registry

# Clé d'API partagée : exigée dans le header X-Ednah-Key sur toutes les routes sauf /api/health.
# Si absente : mode dev (auth désactivée, warning loggé). Générer une valeur longue et aléatoire.
EDNAH_REGISTRY_KEY=change_me_generate_a_long_random_value

# Origine CORS autorisée (défaut * si absente).
STUDIO_CORS_ORIGIN=*

# --- Login par code d'accès (POST /api/auth/login) ---
# Code d'accès attendu de l'app Studio. Si ABSENT : le login est refusé (503),
# aucune tentative ne passe. Générer une valeur longue et aléatoire.
EDNAH_ACCESS_CODE=change_me_generate_a_long_random_value

# --- Config client renvoyée par le bootstrap après login réussi ---
# Ces valeurs sont envoyées à l'app Studio (elle ne saisit jamais de clés).
# ⚠️ CLIENT_COOLIFY_TOKEN et CLIENT_GITHUB_TOKEN sont des SECRETS : ne jamais
#    committer de vraies valeurs, les configurer uniquement côté serveur (Coolify).
CLIENT_REGISTRY_URL=https://registry.dev.ednah-group.com
CLIENT_COOLIFY_URL=https://coolify.ednah-group.com
CLIENT_COOLIFY_SERVER_UUID=change_me_coolify_server_uuid
CLIENT_DEV_DOMAIN=dev.ednah-group.com
CLIENT_GITHUB_APP_UUID=change_me_github_app_uuid
CLIENT_COOLIFY_TOKEN=change_me_coolify_api_token
CLIENT_GITHUB_TOKEN=change_me_github_token
CLIENT_GITHUB_OWNER=ednah-group
